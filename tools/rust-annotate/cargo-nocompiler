#!/usr/bin/env python3
"""Build a Cargo binary with automatic NoCompiler entry contracts."""

import argparse
import hashlib
import json
import os
import re
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

from collection_inference import discover, struct_fields
from heap_contracts import add_heap_borrow, allocator_contracts, discover_rust_allocators, heap_callers
from loop_inference import annotate
from memory_inference import infer_requirements
from source_trace import inline_traces, without_debug_sections
from stack_inference import stack_annotations

TOOLCHAIN = "nightly-2026-09-17"
TARGET = "riscv64imac-unknown-none-elf"
TOOL_DIR = Path(__file__).resolve().parent
REPO = TOOL_DIR.parent.parent
RUST_FLAGS = [
    "-C", "target-feature=-c,-zca", "-C", "codegen-units=1",
    "-C", "panic=abort", "-C", "lto=off", "-C", "link-dead-code=yes",
    "-C", "link-arg=--no-relax",
]


def build_flags(source_trace):
    return RUST_FLAGS + (["-C", "debuginfo=2", "-C", "strip=none"] if source_trace else [])


def run_build(args, artifacts):
    env = os.environ.copy()
    sysroot = subprocess.check_output(
        ["rustc", f"+{TOOLCHAIN}", "--print", "sysroot"], text=True
    ).strip()
    driver = artifacts / "capture-rustc"
    subprocess.run(
        [
            "rustc", f"+{TOOLCHAIN}", "--edition=2024", "-C", "opt-level=2",
            "-L", f"native={sysroot}/lib", "-C", f"link-arg=-Wl,-rpath,{sysroot}/lib",
            "-o", driver, TOOL_DIR / "driver.rs",
        ],
        check=True,
    )
    env.update(
        RUSTC_WRAPPER=str(driver),
        RUSTC_WORKSPACE_WRAPPER="",
        RUSTC=str(Path(sysroot) / "bin/rustc"),
        NOCOMPILER_CAPTURE_PATH=str(artifacts),
        NOCOMPILER_CAPTURE_TARGETS="\n".join(args.function),
        NOCOMPILER_RUST_SYSROOT=sysroot,
    )
    assembly = artifacts / "rustc.s"
    command = [
        "cargo", f"+{TOOLCHAIN}", "rustc", "--manifest-path", args.manifest_path,
        "--target", TARGET, "--target-dir", artifacts / "target", "--release",
        "--bin", args.bin, "--message-format=json",
    ]
    if args.package:
        command.extend(["--package", args.package])
    command.extend([
        "--", "--nocompiler-capture", f"--emit=asm={assembly}", *build_flags(args.source_trace),
    ])
    build = subprocess.run(command, env=env, text=True, stdout=subprocess.PIPE)
    executables = []
    for line in build.stdout.splitlines():
        event = json.loads(line)
        if event["reason"] == "compiler-message":
            print(event["message"].get("rendered") or event["message"]["message"], file=sys.stderr)
        elif event["reason"] == "compiler-artifact" and event.get("executable"):
            if event["target"]["name"] == args.bin and "bin" in event["target"]["kind"]:
                executables.append(Path(event["executable"]))
    build.check_returncode()
    if len(executables) != 1:
        raise ValueError("Cargo did not produce exactly one selected executable")
    image = artifacts / "verified.elf"
    shutil.copyfile(executables[0], image)
    version = subprocess.check_output(["rustc", f"+{TOOLCHAIN}", "-vV"], text=True)
    host = next(line.removeprefix("host: ") for line in version.splitlines() if line.startswith("host: "))
    nm = Path(sysroot) / "lib/rustlib" / host / "bin/llvm-nm"
    return assembly, image, nm, version.splitlines()[0]


FUNCTION_TYPE = re.compile(r"\s*\.type\s+([^,]+),\s*@function\s*$")
SYMBOL_SIZE = re.compile(r"\s*\.size\s+([^,]+),")
GLOBAL_SYMBOL = re.compile(r"\s*\.globl\s+(\S+)\s*$")


def read_map(path):
    return dict(line.split("\t", 1) for line in path.read_text().splitlines())


def entry_contract(symbol, output, arguments, requirements=None, invariants=None, inferred=None):
    params = []
    inputs = []
    borrows = []
    owned = []
    constraints = []
    slice_bounds = []
    postconditions = []
    seeds = {"sp": {"entrysp": 1}}
    lengths = []
    slices = []
    pointers = {}
    requirements = requirements or {}
    invariants = invariants or {}
    inferred = inferred or {}
    for index, argument in enumerate(arguments):
        register = len(inputs)
        if argument == "word":
            value = f"x{index}"
            params.append(value)
            inputs.append(f"a{register}: int({value})")
            seeds[f"a{register}"] = {value: 1}
        elif argument.startswith("box:"):
            _, size, align = argument.split(":")
            base = f"p{index}"
            params.append(base)
            inputs.append(f"a{register}: u64({base})")
            seeds[f"a{register}"] = {base: 1}
            owned.append(f"{base} |-> bytes[{size}] rw heap")
            constraints.extend([f"{base} != 0", f"{align} | {base}"])
        elif argument == "ptr":
            reg = f"a{register}"
            base = f"p{index}"
            pointers[reg] = base
            if reg in requirements:
                size, align, writable = requirements[reg]
                permission = "rw" if writable else "ro"
                params.append(base)
                inputs.append(f"{reg}: int({base})")
                borrows.append(f"{base} |-> bytes[{size}] {permission}")
                if align > 1:
                    constraints.append(f"{align} | {base}")
            else:
                inputs.append(f"{reg}: int")
        else:
            pieces = argument.split(":", 4)
            kind, size, align, permission = pieces[:4]
            if kind not in ("ref", "slice", "struct"):
                raise ValueError(f"unknown ABI argument kind {kind}")
            base = f"p{index}"
            params.append(base)
            inputs.append(f"a{register}: int({base})")
            seeds[f"a{register}"] = {base: 1}
            region = size
            if kind == "slice":
                length = f"n{index}"
                params.append(length)
                inputs.append(f"a{register + 1}: u64({length})")
                seeds[f"a{register + 1}"] = {length: 1}
                lengths.append(length)
                if int(size):
                    slices.append((base, length, int(size)))
                region = f"{size}*{length}"
                slice_bounds.append(f"{base} + {region} < 2^64")
            capability = f"{base} |-> bytes[{region}] {permission}"
            if kind == "struct":
                type_name, fields = struct_fields(pieces[4])
                entry_fields = []
                exit_fields = []
                automatic = type_name not in invariants
                proposed = inferred.get(type_name, {}) if automatic else invariants[type_name]
                for field, array in sorted(proposed.items()):
                    offset, detail = fields.get(field, (None, None))
                    capacity = fields.get(array, (None, ""))[1]
                    if detail != "word" or not capacity.isdecimal() or int(align) < 8:
                        if automatic:
                            continue
                        raise ValueError(f"invalid length/array invariant for {type_name}: {field}, {array}")
                    value = f"field{index}_{len(entry_fields)}"
                    params.append(value)
                    entry_fields.append(f"{offset}: int({value})")
                    seeds[(base, int(offset))] = {value: 1}
                    constraints.append(f"0 <= {value} <= {capacity}")
                    if permission == "rw":
                        updated = f"{value}_after"
                        exit_fields.append(f"{offset}: int({updated})")
                        postconditions.append(f"0 <= {updated} <= {capacity}")
                if entry_fields:
                    capability += " {" + ", ".join(entry_fields) + "}"
                if exit_fields:
                    capability += " -> {" + ", ".join(exit_fields) + "}"
            borrows.append(capability)
            if int(align) > 1:
                constraints.append(f"{align} | {base}")

    text = f"#: fn {symbol} [{', '.join(params)}]"
    if owned or output.startswith("box:"):
        borrows.insert(0, "Heap")
    for clause, entries in (("in", inputs), ("borrow", borrows), ("take", owned),
                            ("where", constraints + slice_bounds)):
        if entries:
            text += f" {clause} {', '.join(entries)}"
    if output.startswith("box:"):
        _, size, align = output.split(":")
        text += f" out a0: u64(boxout) give boxout |-> bytes[{size}] rw heap"
        postconditions.extend(["boxout != 0", f"{align} | boxout"])
    elif output == "pair":
        text += " out a0: int, a1: int"
    elif output == "word" or postconditions:
        text += " out a0: int"
    elif output != "void":
        raise ValueError(f"unknown ABI return kind {output}")
    if postconditions:
        text += " where " + ", ".join(postconditions)
    return text + " stack 0\n", (seeds, lengths, slices), pointers


def read_abi(path):
    symbols = {}
    layouts = {}
    for line in path.read_text().splitlines():
        name, symbol, output, arguments = line.split("\t")
        symbols[name] = symbol
        layouts[symbol] = (output, arguments.split(",") if arguments else [])
    return symbols, layouts


def select_assembly(source, selected):
    """Drop bodies for unselected functions while retaining data directives."""
    keep = True
    found = set()
    for line in source.splitlines(keepends=True):
        if match := FUNCTION_TYPE.fullmatch(line):
            name = match[1]
            keep = name in selected
            if keep:
                found.add(name)
        if keep:
            yield line
        if SYMBOL_SIZE.match(line):
            keep = True
    if missing := selected - found:
        raise ValueError(f"function has no compiler assembly body: {', '.join(sorted(missing))}")


def check(args, artifacts):
    assembly, image, nm, version = run_build(args, artifacts)
    symbols, layouts = read_abi(artifacts / "abi.tsv")
    unsupported = read_map(artifacts / "unsupported.tsv")
    mir_callees = {}
    for kind in ("inlined", "mir-calls"):
        callees = {}
        for line in (artifacts / f"{kind}.tsv").read_text().splitlines():
            caller, callee = line.split("\t", 1)
            callees.setdefault(caller, []).append(callee)
        mir_callees[kind] = callees
    if (
        set(symbols) & set(unsupported)
        or set(symbols) | set(unsupported) != set(args.function)
        or len(set(symbols.values())) != len(symbols)
    ):
        raise ValueError("compiler capture did not uniquely identify the requested functions")
    listing = subprocess.check_output([nm, "--defined-only", "--format=posix", image], text=True)
    linked = {
        parts[0]: (int(parts[2], 16), int(parts[3], 16))
        for line in listing.splitlines()
        if len(parts := line.split()) >= 4 and parts[1] in ("T", "t")
    }
    traces = inline_traces(args.symbolizer, image, linked, symbols) if args.source_trace else {}
    source = "".join(without_debug_sections(assembly.read_text()))
    global_symbols = {
        match[1] for line in source.splitlines() if (match := GLOBAL_SYMBOL.fullmatch(line))
    }
    selected = set(symbols.values()) & linked.keys() & global_symbols
    annotated = artifacts / "annotated.s"
    body = "".join(select_assembly(source, selected)) if selected else ""
    pointers = {symbol: entry_contract(symbol, *layouts[symbol])[2] for symbol in selected}
    requirements = infer_requirements(body, pointers)
    allocator_spec = json.loads(args.allocator_contracts.read_text()) if args.allocator_contracts else {}
    if not isinstance(allocator_spec, dict):
        raise ValueError("allocator contracts must be an object keyed by linked symbol")
    inferred_allocators = discover_rust_allocators(source, body, selected, linked, args.global_allocator_stack)
    allocator_spec = {**inferred_allocators, **allocator_spec}
    external, budgets = allocator_contracts(allocator_spec, linked, selected)
    invariants = json.loads(args.invariants.read_text()) if args.invariants else {}
    if not isinstance(invariants, dict) or any(
        not isinstance(rule, dict) or any(not isinstance(array, str) for array in rule.values())
        for rule in invariants.values()
    ):
        raise ValueError("invariants must map Rust type paths to length-field/array-field mappings")
    inferred_invariants = discover(body, layouts)
    effective_invariants = {name: spec["fields"] for name, spec in inferred_invariants.items()}
    contracts = {}
    abi = {}
    for symbol, layout in layouts.items():
        contracts[symbol], abi[symbol], _ = entry_contract(symbol, *layout, requirements.get(symbol), invariants, effective_invariants)
    owned_functions = {symbol for symbol in selected if any(
        arg.startswith("box:") for arg in (layouts[symbol][0], *layouts[symbol][1])
    )}
    heap_allocators = {symbol for symbol in external
                       if allocator_spec[symbol]["operation"] != "rust_no_alloc_shim_is_unstable_v2"}
    for symbol in heap_callers(body, selected, heap_allocators | owned_functions) - owned_functions:
        contracts[symbol] = add_heap_borrow(contracts[symbol])
    contracts.update(external)
    for symbol, stack in stack_annotations(body, selected, requirements, budgets).items():
        contracts[symbol] = contracts[symbol].removesuffix("stack 0\n") + stack + "\n"
    (artifacts / "contracts.s").write_text("".join(contracts.values()))
    ledger = artifacts / "ledger.json"
    report = {"checker": None, "functions": [], "global_errors": []}
    status = 0
    if selected:
        selected_contracts = "".join(line for symbol, line in contracts.items() if symbol in selected or symbol in external)
        if args.infer_loops:
            body = annotate(body, abi)
        annotated.write_text(selected_contracts + body)
        result = subprocess.run([
            args.checker.resolve(), "check", annotated, "--image", image,
            "--export-lean", artifacts / "Proof.lean", "--prove", "--certs",
            "--lean-dir", args.lean_dir.resolve(), "--ledger", ledger,
        ])
        status = result.returncode
        if ledger.exists():
            report = json.loads(ledger.read_text())
        else:
            report["global_errors"].append(f"checker exited with status {status} without a ledger")
    functions = {item["name"]: item for item in report["functions"]}
    targets = {}
    for path in args.function:
        if path in unsupported:
            targets[path] = {"status": "unsupported", "reason": unsupported[path]}
            continue
        symbol = symbols[path]
        if symbol not in linked:
            targets[path] = {"name": symbol, "status": "missing_linked_symbol"}
        elif symbol not in global_symbols:
            targets[path] = {
                "name": symbol, "status": "unsupported",
                "reason": "no external linkage in optimized assembly, so the entry ABI may differ",
            }
        else:
            targets[path] = functions.get(symbol, {"name": symbol, "status": "checker_error"})
    with image.open("rb") as elf:
        sha256 = hashlib.sha256()
        for block in iter(lambda: elf.read(1024 * 1024), b""):
            sha256.update(block)
        digest = sha256.hexdigest()
    summary = {
        "schema_version": 1,
        "elf_sha256": digest,
        "target": TARGET,
        "profile": "release",
        "rustc_flags": build_flags(args.source_trace),
        "rust_toolchain": TOOLCHAIN,
        "rustc_version": version,
        "checker": report["checker"],
        "contract_file": "contracts.s",
        "infer_loops": args.infer_loops,
        "functions": targets,
        "declared_type_invariants": invariants,
        "inferred_type_invariants": inferred_invariants,
        "allocator_assumptions": allocator_spec,
        "mir_inlined_callees": mir_callees["inlined"],
        "mir_direct_callees": mir_callees["mir-calls"],
        "dwarf_inline_ranges": traces,
        "inferred_raw_pointer_requirements": {
            symbol: {
                reg: {"bytes": size, "alignment": align, "access": "rw" if writable else "ro"}
                for reg, (size, align, writable) in regions.items()
            }
            for symbol, regions in requirements.items() if regions
        },
        "global_errors": report["global_errors"],
    }
    (artifacts / "report.json").write_text(json.dumps(summary, indent=2) + "\n")
    for path, entry in targets.items():
        detail = f" ({entry['reason']})" if "reason" in entry else ""
        print(f"{path}: {entry['status']}{detail}")
    if status not in (0, 1) or (selected and not ledger.exists()):
        return 2
    accepted = {"proved", "proved_assuming"} if args.allow_assumptions else {"proved"}
    return int(
        status != 0
        or bool(report["global_errors"])
        or any(entry["status"] not in accepted for entry in targets.values())
    )


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["nocompiler"]:
        argv = argv[1:]
    parser = argparse.ArgumentParser(prog="cargo nocompiler")
    commands = parser.add_subparsers(required=True)
    command = commands.add_parser("check")
    command.add_argument("--manifest-path", default="Cargo.toml", type=Path)
    command.add_argument("--package")
    command.add_argument("--symbolizer", default="llvm-symbolizer")
    command.add_argument("--no-source-trace", dest="source_trace", action="store_false",
                         help="build without DWARF inline tracing")
    command.add_argument("--invariants", type=Path, help="JSON map of aggregate length fields to backing arrays")
    command.add_argument("--allocator-contracts", type=Path, help="JSON map of linked allocator ABI assumptions")
    command.add_argument("--global-allocator-stack", type=int, default=4096,
                         help="assumed stack budget for discovered Rust allocator shims")
    command.add_argument("--allow-assumptions", action="store_true", help="accept proofs that assume allocator contracts")
    command.add_argument("--no-infer-loops", dest="infer_loops", action="store_false")
    command.add_argument("--bin", required=True)
    command.add_argument("--function", action="append", required=True, help="crate::module::name")
    command.add_argument("--artifacts", type=Path, help="new directory for this verification run")
    command.add_argument("--checker", type=Path, default=REPO / "target/release/nocompiler-typed")
    command.add_argument("--lean-dir", type=Path, default=REPO / "lean")
    args = parser.parse_args(argv)
    if len(set(args.function)) != len(args.function) or any(
        not name.strip() or any(ch in name for ch in "\t\r\n") for name in args.function
    ):
        parser.error("function paths must be unique and contain no tabs or newlines")
    try:
        if args.artifacts:
            artifacts = args.artifacts.resolve()
            artifacts.mkdir(parents=True)
        else:
            artifacts = Path(tempfile.mkdtemp(prefix="nocompiler-rust-"))
        print(f"Artifacts: {artifacts}", flush=True)
        return check(args, artifacts)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"NoCompiler: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
