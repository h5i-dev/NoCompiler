import Examples.LPS.FuzzQdisc.Statements
import Examples.LPS.Images.QdiscPlainOvp
import Examples.LPS.Images.QdiscUbsanOvp
import Examples.LPS.Images.QdiscAsanOvp
import Examples.LPS.Images.QdiscAsanUbsanOvp

/-!
# fuzz_qdisc's statements for oss-verify's published builds (round 4 goal (b))

`Images` as in `projects/reac-pw/fuzz_qdisc/Images.v` (oss-verify-proofs; MIT, Theorem Labs): the memory images
of the four published binaries (release v2026.11.1, asset reac-pw-bin.tar.zst; each file's sha256 equals the
one harness.yaml pins, and is in its image module's header), generated by scripts/lps/elf_snapshot_lean.py
(LPS's own elf_snapshot `_parse_elf`). The nine statements of Statements.v on them, same names. Statements
only; nothing here claims they hold (oss-verify's README lists all nine as proved in Rocq).
The two ASan image modules are generated, not stored (12 MB each): examples/qdisc/gen_qdisc_images.sh.
-/

namespace LPS.OSSVerify.ReacPw.FuzzQdisc.Ovp
open LPS LPS.OSSVerify

namespace Images
def plain : Image := mkImage LPS.Images.QdiscPlainOvp.loaded_segments LPS.Images.QdiscPlainOvp.init_pc LPS.Images.QdiscPlainOvp.phdrs
def ubsan : Image := mkImage LPS.Images.QdiscUbsanOvp.loaded_segments LPS.Images.QdiscUbsanOvp.init_pc LPS.Images.QdiscUbsanOvp.phdrs
def asan : Image := mkImage LPS.Images.QdiscAsanOvp.loaded_segments LPS.Images.QdiscAsanOvp.init_pc LPS.Images.QdiscAsanOvp.phdrs
def asan_ubsan : Image :=
  mkImage LPS.Images.QdiscAsanUbsanOvp.loaded_segments LPS.Images.QdiscAsanUbsanOvp.init_pc LPS.Images.QdiscAsanUbsanOvp.phdrs
end Images

def plain_halts : Prop := FuzzQdisc.plain_halts Images.plain
def ubsan_halts : Prop := FuzzQdisc.ubsan_halts Images.ubsan
def asan_halts : Prop := FuzzQdisc.asan_halts Images.asan
def asan_ubsan_halts : Prop := FuzzQdisc.asan_ubsan_halts Images.asan_ubsan
def plain_halts_may_fail : Prop := FuzzQdisc.plain_halts_may_fail Images.plain
def ubsan_halts_may_fail : Prop := FuzzQdisc.ubsan_halts_may_fail Images.ubsan
def asan_agrees : Prop := FuzzQdisc.asan_agrees Images.plain Images.asan
def ubsan_agrees : Prop := FuzzQdisc.ubsan_agrees Images.plain Images.ubsan
def asan_ubsan_agrees : Prop := FuzzQdisc.asan_ubsan_agrees Images.plain Images.asan_ubsan

end LPS.OSSVerify.ReacPw.FuzzQdisc.Ovp
